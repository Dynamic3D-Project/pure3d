{
	"name": "top-svelte-pocketbase",
	"private": true,
	"version": "0.14.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev --open",
		"build": "export PUBLIC_POCKETBASE_URL=https://pure3d-database.ctwhome.com PUBLIC_ASSET_BASE_URL=https://pure3d-assets.ctwhome.com; paraglide-js compile --project ./locale/project.inlang --outdir ./src/lib/paraglide --silent && node -e \"require('fs').appendFileSync('src/lib/paraglide/messages/_index.js','\\nexport {};\\n')\" && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "export PUBLIC_POCKETBASE_URL=https://pure3d-database.ctwhome.com PUBLIC_ASSET_BASE_URL=https://pure3d-assets.ctwhome.com; paraglide-js compile --project ./locale/project.inlang --outdir ./src/lib/paraglide --silent && node -e \"require('fs').appendFileSync('src/lib/paraglide/messages/_index.js','\\nexport {};\\n')\" && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"seed": "bun scripts/seed-data.ts",
		"migrate:viewer-help": "bun scripts/add-viewer-help-field.ts",
		"migrate:workflow": "bun scripts/migrate-workflow-statuses.ts"
	},

      "isDeleted": false,
      "boundElements": [],
      "updated": 1761037027976,
      "link": null,
      "locked": false,
      "text": "Each of the collections\nshould have its name\nvisible. Jesse can decide\nhow to display the name\nof each collection (e.g.,\non top of image,\nunderneath, flipbox etc.).\nJesse can also decide on\nthe aesthetics of each\ncolletion preview - we\nlike the uneven look.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each of the collections should have its name visible. Jesse can decide how to display the name of each collection (e.g., on top of image, underneath, flipbox etc.). Jesse can also decide on the aesthetics of each colletion preview - we like the uneven look.",
      "autoResize": false,
      "lineHeight": 1.25
    },

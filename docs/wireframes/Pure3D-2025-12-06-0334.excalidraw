    {
      "id": "si5GJddhQyE8jZ90UDfVW",
      "type": "text",
      "x": 3613.585609353898,
      "y": 3336.8495781235415,
      "width": 1872.834716796875,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",

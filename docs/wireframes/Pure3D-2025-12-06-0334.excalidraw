    {
      "id": "gXMldkvDLvYWjtcMXIB_b",
      "type": "text",
      "x": 517.2445536353872,
      "y": 4055.1403308445674,
      "width": 685.472250958626,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",

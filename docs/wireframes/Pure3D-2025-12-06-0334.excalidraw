      "isDeleted": false,
      "boundElements": [],
      "updated": 1762949208485,
      "link": null,
      "locked": false,
      "text": "On the editions tab each user will be able to see the editions and collections associated with their account. They should also be able to\nsee the different ser rights they have for each edition. For example, someone may be an editor for one but a reviewer for another edition.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "zmN6Bqe_b-jodvv6-DaSL",
      "originalText": "On the editions tab each user will be able to see the editions and collections associated with their account. They should also be able to see the different ser rights they have for each edition. For example, someone may be an editor for one but a reviewer for another edition.",
      "autoResize": true,
      "lineHeight": 1.25
    },

      "link": null,
      "locked": false,
      "text": "For Data Sources, Creation Process and Modelling Decisions fields are\nfree text using a rich editor that allows for hyperlinking to external\nsites (open in new tab) \nas well as the possibility to deep link back into the voyager experience\nto a specifc article, annotation, tour step, etc. and potential for\nuploading a document, image, etc. (not zip files or large datasets). ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For Data Sources, Creation Process and Modelling Decisions fields are free text using a rich editor that allows for hyperlinking to external sites (open in new tab) \nas well as the possibility to deep link back into the voyager experience to a specifc article, annotation, tour step, etc. and potential for uploading a document, image, etc. (not zip files or large datasets). ",
      "autoResize": false,
      "lineHeight": 1.25
    },

      "link": null,
      "locked": false,
      "text": "This is the landing page of the login of the authoring side. Users should be able to login in different ways: with an account already created, ORCIDID, and CLARIAH authentication (which is currently the case)",
      "fontSize": 20,
      "fontFamily": 5,

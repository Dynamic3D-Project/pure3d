      "index": "b38",
      "roundness": null,
      "seed": 889831314,
      "version": 803,
      "versionNonce": 928877970,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "IU1YoOv4kaKjWh9UF9m13",
          "type": "arrow"
        }
      ],
      "updated": 1761210422149,
      "link": null,
      "locked": false,
      "text": "Author indicates in their publishing process whether their 3D scene is downloadable. They can\nonly do this if all 3D models in the scene are with an open copyright, etc. * We need to decide\nwhat exactly is downloadable, e.g., per 3D model, as Smithsonian has it (see below). \n",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Author indicates in their publishing process whether their 3D scene is downloadable. They can only do this if all 3D models in the scene are with an open copyright, etc. * We need to decide what exactly is downloadable, e.g., per 3D model, as Smithsonian has it (see below). \n",
      "autoResize": false,
      "lineHeight": 1.25
    },

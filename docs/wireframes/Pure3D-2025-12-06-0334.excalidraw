      "isDeleted": false,
      "boundElements": [],
      "updated": 1761037027977,
      "link": null,
      "locked": false,
      "text": "On this page we need to have the collection\ntitle, the collection description, and a way to get into the editions\nassociated with the collection.\n\nThere may be collections with 3 editions but also collections with 20\n\nJesse can decide what is the best way to create such a collection page",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "On this page we need to have the collection\ntitle, the collection description, and a way to get into the editions\nassociated with the collection.\n\nThere may be collections with 3 editions but also collections with 20\n\nJesse can decide what is the best way to create such a collection page",
      "autoResize": true,
      "lineHeight": 1.25
    },

      "isDeleted": false,
      "boundElements": [
        {
          "id": "anZ-hh1eVMC1miLUuBq81",
          "type": "arrow"
        }
      ],
      "updated": 1761037027978,
      "link": null,
      "locked": false,
      "text": "We can look into the Voyager API's for\nconnecting hyperlinked text on the\nwebpage with specific Voyager Scene\nsettings (e.g, a specific tour step). This\nwould be relevant for Description, Peer\nReview and Paradata. However, in the\nauthoring side, we need to have a user-\nfriendly way to make this connection.  ",
      "fontSize": 10.148819247918086,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We can look into the Voyager API's for connecting hyperlinked text on the webpage with specific Voyager Scene settings (e.g, a specific tour step). This would be relevant for Description, Peer Review and Paradata. However, in the authoring side, we need to have a user-friendly way to make this connection.  ",
      "autoResize": false,
      "lineHeight": 1.25
    },

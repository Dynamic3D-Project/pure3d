# PocketBase Configuration
POCKETBASE_PORT=8090
POCKETBASE_ADMIN_EMAIL=admin@admin.local
POCKETBASE_ADMIN_PASSWORD=1234567890

# Frontend Configuration
FRONTEND_PORT=8080

# Public PocketBase URL (used by frontend in browser)
PUBLIC_POCKETBASE_URL=http://localhost:8090

# Server-side PocketBase URL (internal Docker network, for server-side requests)
# Note: Internal Docker network always uses port 8090 (container port)
POCKETBASE_URL=http://pocketbase:8090

# PocketBase Admin Credentials (for initial setup and data import)
POCKETBASE_ADMIN_EMAIL=admin@admin.local
POCKETBASE_ADMIN_PASSWORD=1234567890

# Development
NODE_ENV=development

# Asset serving in local dev: MinIO bucket exposed by docker-compose.
# Use a CDN/public bucket URL in production.
PUBLIC_ASSET_BASE_URL=http://localhost:9000/pure3d-assets

# S3-compatible storage for PocketBase.
# Local dev defaults target the MinIO service in docker-compose.
R2_ENDPOINT=http://minio:9000
R2_BUCKET=pure3d-assets
R2_ACCESS_KEY_ID=pure3d
R2_SECRET_ACCESS_KEY=pure3d-local-secret

# Production R2 example:
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=pure3d-assets
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...

# Show demo-account quick-login buttons on the login form in production
# builds too (always shown in dev). Set to "true" to expose the three seeded
# test accounts on the production login form.
PUBLIC_SHOW_DEMO_ACCOUNTS=false

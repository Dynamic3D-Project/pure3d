# PocketBase Configuration
POCKETBASE_PORT=60021
MINIO_API_PORT=60023
MINIO_CONSOLE_PORT=60024
POCKETBASE_ADMIN_EMAIL=admin@admin.local
POCKETBASE_ADMIN_PASSWORD=1234567890

# Frontend Configuration
FRONTEND_PORT=60020

# Make local commands force same-origin HTTPS URLs using FRONTEND_PORT above.
# make dev-prod explicitly forces live OVH URLs; PUBLIC_* never selects Make mode.
# These PUBLIC_* values also support direct frontend commands/builds.
PUBLIC_POCKETBASE_URL=https://127.0.0.1:60020

# Server-side PocketBase URL (internal Docker network, for server-side requests)
# Note: Internal Docker network always uses port 8090 (container port)
POCKETBASE_URL=http://pocketbase:8090

# PocketBase Admin Credentials (for initial setup and data import)
POCKETBASE_ADMIN_EMAIL=admin@admin.local
POCKETBASE_ADMIN_PASSWORD=1234567890

# Runtime mode is selected by the dev/build scripts, not shared environment settings.

# Asset serving in local dev: Vite proxies /assets to the local MinIO bucket.
# Use a CDN/public bucket URL in production.
PUBLIC_ASSET_BASE_URL=https://127.0.0.1:60020/assets

# S3-compatible storage for PocketBase.
# Local Make setup forces MinIO and uses MINIO_ROOT_* credentials, not R2_* credentials.
MINIO_ROOT_USER=pure3d
MINIO_ROOT_PASSWORD=pure3d-local-secret
R2_ENDPOINT=http://minio:9000
R2_BUCKET=pure3d-assets
R2_REGION=auto
R2_ACCESS_KEY_ID=pure3d
R2_SECRET_ACCESS_KEY=pure3d-local-secret

# Production R2 example:
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=pure3d-assets
# R2_REGION=auto
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...

# Local PocketBase uses the REAL https://orcid.org issuer, with an isolated local DB.
# Local Bun containers receive empty ORCID_CLIENT_ID/ORCID_CLIENT_SECRET.
# Reuse the existing real ORCID client in private .env for explicit host configuration.
# Add https://127.0.0.1:60020/api/oauth2-redirect to its callbacks; keep the OVH callback.
# ORCID_ENVIRONMENT=production selects the real provider, NOT the database destination.
# See docs/development.md for local endpoint overrides and apply prerequisites.
# Make supplies private DEV_HTTPS, DEV_POCKETBASE_TARGET, DEV_ASSET_TARGET and
# DEV_ASSET_BUCKET. Do not prefix these internal routing settings with PUBLIC_ or VITE_.
